* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Arial, sans-serif;
  background: #f4f6fb;
  color: #111827;
}

.auth-container {
  width: min(420px, calc(100% - 32px));
  margin: 80px auto;
  background: #ffffff;
  padding: 32px;
  border-radius: 16px;
  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
}

.dashboard {
  width: min(680px, calc(100% - 32px));
  margin: 48px auto;
  padding: 32px;
  background: #ffffff;
  border-radius: 16px;
  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
}

.study-session {
  margin: 28px 0;
  padding: 24px;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
}

.study-session h2 {
  margin-top: 0;
}

.session-fields {
  display: grid;
  gap: 8px;
}

.session-fields label {
  margin-top: 8px;
}

select {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid #d1d5db;
  border-radius: 9px;
  background: #ffffff;
  font-size: 15px;
}

.timer-display {
  margin: 24px 0;
  text-align: center;
  font-family: monospace;
  font-size: clamp(2.5rem, 12vw, 4rem);
  font-variant-numeric: tabular-nums;
}

.session-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.session-status {
  min-height: 24px;
  margin-bottom: 0;
}

.study-stats {
  margin: 28px 0;
}

.study-stats h2 {
  margin-bottom: 8px;
}

.stats-message {
  min-height: 24px;
  color: #6b7280;
}

.stats-summary,
.stats-details {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
  margin: 16px 0;
}

.stat-card {
  padding: 16px;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
}

.stat-card h3,
.stats-details h3 {
  margin-top: 0;
}

.stat-card p {
  margin-bottom: 0;
}

.subject-totals {
  display: grid;
  gap: 8px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.subject-totals li {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid #e5e7eb;
}

.daily-chart {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 8px;
  min-width: 280px;
}

.daily-chart-column {
  display: grid;
  grid-template-rows: auto 140px auto;
  justify-items: center;
  gap: 6px;
  min-width: 0;
}

.daily-chart-value,
.daily-chart-label {
  color: #6b7280;
  font-size: 0.75rem;
  text-align: center;
}

.daily-chart-track {
  display: flex;
  width: min(28px, 100%);
  height: 100%;
  align-items: flex-end;
  overflow: hidden;
  border-radius: 6px;
  background: #eef2ff;
}

.daily-chart-bar {
  width: 100%;
  min-height: 0;
  border-radius: 6px;
  background: #4f46e5;
}

.session-history {
  margin: 28px 0;
}

.session-history h2 {
  margin-bottom: 8px;
}

.history-message {
  min-height: 24px;
  color: #6b7280;
}

.history-table-wrap {
  overflow-x: auto;
}

.history-table-wrap table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.history-table-wrap th,
.history-table-wrap td {
  padding: 10px 12px;
  border-bottom: 1px solid #e5e7eb;
  white-space: nowrap;
}

.history-table-wrap th {
  color: #4b5563;
  font-size: 0.875rem;
}

button:disabled,
select:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

.auth-container h1 {
  margin-bottom: 8px;
}

.auth-container > p {
  color: #6b7280;
}

form {
  display: grid;
  gap: 18px;
  margin-top: 24px;
}

label {
  display: grid;
  gap: 7px;
  font-weight: 600;
}

input {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid #d1d5db;
  border-radius: 9px;
  font-size: 15px;
  outline: none;
}

input:focus {
  border-color: #4f46e5;
}

button {
  border: 0;
  padding: 12px 16px;
  border-radius: 9px;
  background: #4f46e5;
  color: white;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
}

button:hover {
  background: #4338ca;
}

a {
  display: inline-block;
  margin-top: 18px;
  color: #4f46e5;
  text-decoration: none;
}

#message {
  min-height: 24px;
  margin-top: 16px;
}

.success {
  color: #15803d;
}

.error {
  color: #dc2626;
}/* StudySprint dashboard redesign */
body {
  background: #f4f6fc;
}

.dashboard {
  width: min(1100px, calc(100% - 32px));
  margin: 32px auto;
  padding: 36px;
  background: #ffffff;
  border: 1px solid #e8eaf3;
  border-radius: 24px;
  box-shadow: 0 16px 48px rgba(31, 41, 85, 0.08);
}

.dashboard h1 {
  margin: 0 0 16px;
  font-size: clamp(28px, 4vw, 40px);
  letter-spacing: -1px;
}

.dashboard h2 {
  margin: 0 0 20px;
  font-size: 25px;
  letter-spacing: -0.5px;
}

.dashboard h3 {
  margin: 0 0 14px;
  font-size: 18px;
}

.dashboard > p {
  color: #586174;
  margin: 10px 0;
}

.study-stats,
.study-session,
.session-history {
  margin-top: 32px;
  padding: 26px;
  background: #fff;
  border: 1px solid #e4e7f0;
  border-radius: 18px;
}

.stats-summary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-top: 22px;
}

.stat-card {
  padding: 24px;
  background: #f7f8ff;
  border: 1px solid #e7e9fb;
  border-radius: 16px;
}

.stat-card p {
  margin: 12px 0 0;
  color: #596174;
}

.stat-card p strong {
  color: #171b2c;
  font-size: 25px;
}

.stats-details {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
  gap: 28px;
  margin-top: 28px;
}

.subject-totals {
  list-style: none;
  padding: 0;
  margin: 0;
}

.subject-totals li {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid #eceef5;
}

.daily-chart {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 10px;
  min-height: 230px;
  align-items: stretch;
}

.daily-chart-column {
  display: grid;
  grid-template-rows: auto 1fr auto;
  gap: 8px;
  min-width: 0;
  text-align: center;
}

.daily-chart-value,
.daily-chart-label {
  color: #737b90;
  font-size: 12px;
}

.daily-chart-track {
  height: 160px;
  align-self: end;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  background: #edf0ff;
  border-radius: 10px;
}

.daily-chart-bar {
  width: 100%;
  min-height: 0;
  background: linear-gradient(180deg, #8274ff, #5141e5);
  border-radius: 9px;
  transition: height 0.3s ease;
}

.session-fields {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px;
}

.session-fields label {
  margin-top: 8px;
  font-weight: 600;
}

.session-fields select {
  width: 100%;
  min-height: 48px;
  padding: 10px 14px;
  background: #fff;
  border: 1px solid #dfe3ed;
  border-radius: 12px;
}

.timer-display {
  margin: 28px 0;
  text-align: center;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: clamp(42px, 7vw, 68px);
  font-weight: 700;
  letter-spacing: 2px;
  color: #171b2c;
  font-variant-numeric: tabular-nums;
}

.session-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.session-actions button {
  min-width: 100px;
  padding: 13px 22px;
  border: 0;
  border-radius: 11px;
  background: #6254e8;
  color: #fff;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.15s, background 0.15s;
}

.session-actions button:hover:not(:disabled) {
  background: #4939d0;
  transform: translateY(-1px);
}

.session-actions button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.session-status,
.stats-message,
.history-message {
  color: #697287;
  line-height: 1.6;
}

.session-status.error,
.stats-message.error,
.history-message.error {
  color: #c0394b;
}

.session-status.success {
  color: #16804a;
}

.session-history {
  overflow-x: auto;
}

@media (max-width: 700px) {
  .dashboard {
    width: calc(100% - 20px);
    margin: 10px auto;
    padding: 20px;
    border-radius: 16px;
  }

  .study-stats,
  .study-session,
  .session-history {
    padding: 18px;
    margin-top: 22px;
  }

  .stats-summary,
  .stats-details {
    grid-template-columns: 1fr;
  }

  .daily-chart {
    gap: 6px;
  }

  .daily-chart-value,
  .daily-chart-label {
    font-size: 10px;
  }
}

/* ===== StudySprint: polished compact dashboard ===== */

.dashboard {
  max-width: 1120px;
  margin: 24px auto;
  padding: 32px;
}

.dashboard > h1 {
  font-size: 34px;
  margin-bottom: 20px;
}

.dashboard > p {
  display: inline-flex;
  align-items: center;
  margin: 0 18px 24px 0;
  padding: 10px 14px;
  background: #f7f8fc;
  border: 1px solid #e9ebf4;
  border-radius: 10px;
  font-size: 14px;
}

.dashboard > p strong {
  margin-left: 5px;
  color: #5141e5;
}

.study-stats,
.study-session,
.session-history {
  margin-top: 22px;
  padding: 24px;
  border-radius: 16px;
}

.dashboard h2 {
  font-size: 22px;
  margin-bottom: 12px;
}

.stats-message {
  margin: 8px 0 20px;
  font-size: 13px;
}

.stats-summary {
  gap: 14px;
  margin-top: 16px;
}

.stat-card {
  padding: 20px;
  border-radius: 14px;
  background: linear-gradient(135deg, #f8f8ff, #f1f3ff);
}

.stat-card h3 {
  font-size: 15px;
  color: #626b80;
}

.stat-card p {
  margin-top: 10px;
  font-size: 14px;
}

.stat-card p strong {
  font-size: 27px;
  letter-spacing: -0.6px;
}

.stats-details {
  gap: 32px;
  margin-top: 24px;
}

.stats-details h3 {
  font-size: 16px;
  line-height: 1.45;
  margin-bottom: 14px;
}

.subject-totals li {
  padding: 12px 0;
  font-size: 14px;
}

.daily-chart {
  gap: 8px;
  min-height: 195px;
}

.daily-chart-track {
  height: 135px;
  border-radius: 8px;
}

.daily-chart-value,
.daily-chart-label {
  font-size: 11px;
}

.study-session h2,
.session-history h2 {
  margin-bottom: 20px;
}

.session-fields {
  max-width: 620px;
}

.timer-display {
  margin: 26px 0;
  font-size: clamp(42px, 6vw, 60px);
}

.session-actions button {
  min-width: 110px;
}

@media (max-width: 700px) {
  .dashboard {
    width: calc(100% - 16px);
    margin: 8px auto;
    padding: 18px;
  }

  .dashboard > h1 {
    font-size: 28px;
  }

  .dashboard > p {
    margin: 0 6px 8px 0;
    padding: 8px 10px;
  }

  .study-stats,
  .study-session,
  .session-history {
    padding: 16px;
  }

  .stats-details {
    gap: 24px;
  }

  .daily-chart {
    gap: 5px;
  }
}

