/* =====================================================
   StudySprint — Modern Dashboard Theme
   Separate override stylesheet; preserves application logic
   ===================================================== */

:root {
  --ss-primary: #6554ed;
  --ss-primary-dark: #5040d5;
  --ss-primary-soft: #f0eeff;
  --ss-text: #191d32;
  --ss-muted: #778098;
  --ss-border: #e7eaf4;
  --ss-surface: #ffffff;
  --ss-background: #f6f7fc;
  --ss-radius: 17px;
  --ss-shadow: 0 5px 22px rgba(38, 43, 92, 0.045);
}

body {
  background: var(--ss-background);
  color: var(--ss-text);
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.dashboard {
  width: min(100% - 48px, 1500px);
  margin-inline: auto;
}

.dashboard h1 {
  color: var(--ss-text);
  font-size: clamp(29px, 3vw, 38px);
  font-weight: 800;
  letter-spacing: -1.1px;
  line-height: 1.2;
  margin-bottom: 22px;
}

.dashboard h2,
.study-stats h2 {
  color: var(--ss-text);
  font-weight: 800;
  letter-spacing: -0.6px;
}

.study-stats {
  background: var(--ss-surface);
  border: 1px solid var(--ss-border);
  border-radius: 22px;
  padding: 26px !important;
  box-shadow: var(--ss-shadow);
  margin-block: 24px;
  min-width: 0;
}

.study-stats h2 {
  font-size: 24px;
  margin: 0 0 22px;
}

.study-stats h3 {
  color: #292e45;
  font-size: 15px;
  font-weight: 750;
  letter-spacing: -0.2px;
  line-height: 1.4;
  margin: 0 0 16px;
}

.study-stats #statsContent {
  min-width: 0;
}

/* Common statistic-card class names, when present */

.study-stats #statsContent .stat-card,
.study-stats #statsContent .summary-card,
.study-stats #statsContent .metric-card,
.study-stats #statsContent .stats-card {
  background: linear-gradient(145deg, #fff 0%, #f8f8ff 100%);
  border: 1px solid #e8eaff;
  border-radius: 16px;
  padding: 20px;
  min-width: 0;
  box-shadow: none;
}

.study-stats #statsContent .stat-card strong,
.study-stats #statsContent .summary-card strong,
.study-stats #statsContent .metric-card strong,
.study-stats #statsContent .stats-card strong {
  color: var(--ss-primary);
  font-weight: 800;
}

/* Chart cards */

.study-stats #statsContent div:has(> #subjectTotals),
.study-stats #statsContent div:has(> #dailyTotalsChart) {
  background: #fff;
  border: 1px solid var(--ss-border);
  border-radius: 16px;
  padding: 20px;
  min-width: 0;
  box-shadow: 0 3px 14px rgba(38, 43, 92, 0.025);
}

#subjectTotals,
#dailyTotalsChart {
  width: 100%;
  min-width: 0;
  color: var(--ss-text);
}

#subjectTotals {
  line-height: 1.5;
}

#subjectTotals > * {
  border-bottom: 1px solid #eff1f7;
  padding-block: 11px;
}

#subjectTotals > *:last-child {
  border-bottom: 0;
}

/* Topic-wise analytics */

.topic-analytics {
  background: #fff;
  border: 1px solid var(--ss-border);
  border-radius: 19px;
  padding: 24px !important;
  margin-block: 24px;
  box-shadow: var(--ss-shadow);
  min-width: 0;
}

.topic-analytics > h3 {
  color: var(--ss-text);
  font-size: 21px;
  font-weight: 800;
  letter-spacing: -0.5px;
  margin: 0 0 8px;
}

.topic-analytics > p {
  color: var(--ss-muted);
  font-size: 13px;
}

.analytics-filters {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  padding: 14px;
  margin-block: 18px;
  background: #f8f9ff;
  border: 1px solid #edf0fa;
  border-radius: 14px;
}

.analytics-filters label {
  display: grid;
  gap: 7px;
  color: #626b82;
  font-size: 12px;
  font-weight: 700;
}

.analytics-filters select {
  width: 100%;
  min-width: 0;
  min-height: 42px;
  padding: 10px 12px;
  background: #fff;
  color: #252a40;
  border: 1px solid #e1e5f0;
  border-radius: 10px;
  font: inherit;
  font-size: 13px;
  outline: none;
}

.analytics-filters select:focus {
  border-color: var(--ss-primary);
  box-shadow: 0 0 0 3px rgba(101, 84, 237, 0.12);
}

#topicTotalsChart {
  display: grid;
  gap: 2px;
  min-width: 0;
}

.topic-chart-row {
  display: grid;
  gap: 9px;
  padding: 15px 2px;
  border-bottom: 1px solid #edf0f6;
  min-width: 0;
}

.topic-chart-row:last-child {
  border-bottom: 0;
}

.topic-chart-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.topic-chart-heading span {
  color: #343950;
  font-size: 13px;
  font-weight: 650;
  overflow-wrap: anywhere;
}

.topic-chart-heading strong {
  flex-shrink: 0;
  color: var(--ss-text);
  font-size: 13px;
  font-weight: 800;
}

.topic-chart-track {
  width: 100%;
  height: 9px;
  background: #efefff;
  border-radius: 999px;
  overflow: hidden;
}

.topic-chart-bar {
  height: 100%;
  background: linear-gradient(90deg, #9285ff, #5f4be8);
  border-radius: inherit;
  transition: width .3s ease;
}

.topic-chart-row small {
  color: #8991a6;
  font-size: 11px;
}

/* Forms and buttons */

.study-stats select,
.study-stats button,
.dashboard select,
.dashboard button {
  border-radius: 10px;
}

.dashboard button,
.study-stats button {
  transition: transform .15s ease, box-shadow .15s ease;
}

.dashboard button:hover,
.study-stats button:hover {
  box-shadow: 0 4px 12px rgba(63, 53, 160, 0.1);
}

.dashboard input:focus,
.dashboard select:focus,
.dashboard textarea:focus {
  outline: none;
  border-color: var(--ss-primary);
  box-shadow: 0 0 0 3px rgba(101, 84, 237, .1);
}

@media (min-width: 1000px) {
  .study-stats {
    padding: 30px !important;
  }
}

@media (max-width: 760px) {
  .dashboard {
    width: calc(100% - 24px);
  }

  .study-stats {
    padding: 16px !important;
    border-radius: 16px;
  }

  .study-stats h2 {
    font-size: 21px;
  }

  .topic-analytics {
    padding: 16px !important;
  }

  .analytics-filters {
    grid-template-columns: 1fr;
    padding: 11px;
  }

  .topic-chart-heading {
    align-items: flex-start;
  }
}
