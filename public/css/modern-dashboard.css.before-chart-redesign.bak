/* =====================================================
   StudySprint — Modern Dashboard Theme
   Separate override stylesheet; preserves application logic
   ===================================================== */

:root {
  --ss-primary: #6554ed;
  --ss-primary-dark: #5040d5;
  --ss-primary-soft: #f0eeff;
  --ss-text: #191d32;
  --ss-muted: #778098;
  --ss-border: #e7eaf4;
  --ss-surface: #ffffff;
  --ss-background: #f6f7fc;
  --ss-radius: 17px;
  --ss-shadow: 0 5px 22px rgba(38, 43, 92, 0.045);
}

body {
  background: var(--ss-background);
  color: var(--ss-text);
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.dashboard {
  width: min(100% - 48px, 1500px);
  margin-inline: auto;
}

.dashboard h1 {
  color: var(--ss-text);
  font-size: clamp(29px, 3vw, 38px);
  font-weight: 800;
  letter-spacing: -1.1px;
  line-height: 1.2;
  margin-bottom: 22px;
}

.dashboard h2,
.study-stats h2 {
  color: var(--ss-text);
  font-weight: 800;
  letter-spacing: -0.6px;
}

.study-stats {
  background: var(--ss-surface);
  border: 1px solid var(--ss-border);
  border-radius: 22px;
  padding: 26px !important;
  box-shadow: var(--ss-shadow);
  margin-block: 24px;
  min-width: 0;
}

.study-stats h2 {
  font-size: 24px;
  margin: 0 0 22px;
}

.study-stats h3 {
  color: #292e45;
  font-size: 15px;
  font-weight: 750;
  letter-spacing: -0.2px;
  line-height: 1.4;
  margin: 0 0 16px;
}

.study-stats #statsContent {
  min-width: 0;
}

/* Common statistic-card class names, when present */

.study-stats #statsContent .stat-card,
.study-stats #statsContent .summary-card,
.study-stats #statsContent .metric-card,
.study-stats #statsContent .stats-card {
  background: linear-gradient(145deg, #fff 0%, #f8f8ff 100%);
  border: 1px solid #e8eaff;
  border-radius: 16px;
  padding: 20px;
  min-width: 0;
  box-shadow: none;
}

.study-stats #statsContent .stat-card strong,
.study-stats #statsContent .summary-card strong,
.study-stats #statsContent .metric-card strong,
.study-stats #statsContent .stats-card strong {
  color: var(--ss-primary);
  font-weight: 800;
}

/* Chart cards */

.study-stats #statsContent div:has(> #subjectTotals),
.study-stats #statsContent div:has(> #dailyTotalsChart) {
  background: #fff;
  border: 1px solid var(--ss-border);
  border-radius: 16px;
  padding: 20px;
  min-width: 0;
  box-shadow: 0 3px 14px rgba(38, 43, 92, 0.025);
}

#subjectTotals,
#dailyTotalsChart {
  width: 100%;
  min-width: 0;
  color: var(--ss-text);
}

#subjectTotals {
  line-height: 1.5;
}

#subjectTotals > * {
  border-bottom: 1px solid #eff1f7;
  padding-block: 11px;
}

#subjectTotals > *:last-child {
  border-bottom: 0;
}

/* Topic-wise analytics */

.topic-analytics {
  background: #fff;
  border: 1px solid var(--ss-border);
  border-radius: 19px;
  padding: 24px !important;
  margin-block: 24px;
  box-shadow: var(--ss-shadow);
  min-width: 0;
}

.topic-analytics > h3 {
  color: var(--ss-text);
  font-size: 21px;
  font-weight: 800;
  letter-spacing: -0.5px;
  margin: 0 0 8px;
}

.topic-analytics > p {
  color: var(--ss-muted);
  font-size: 13px;
}

.analytics-filters {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  padding: 14px;
  margin-block: 18px;
  background: #f8f9ff;
  border: 1px solid #edf0fa;
  border-radius: 14px;
}

.analytics-filters label {
  display: grid;
  gap: 7px;
  color: #626b82;
  font-size: 12px;
  font-weight: 700;
}

.analytics-filters select {
  width: 100%;
  min-width: 0;
  min-height: 42px;
  padding: 10px 12px;
  background: #fff;
  color: #252a40;
  border: 1px solid #e1e5f0;
  border-radius: 10px;
  font: inherit;
  font-size: 13px;
  outline: none;
}

.analytics-filters select:focus {
  border-color: var(--ss-primary);
  box-shadow: 0 0 0 3px rgba(101, 84, 237, 0.12);
}

#topicTotalsChart {
  display: grid;
  gap: 2px;
  min-width: 0;
}

.topic-chart-row {
  display: grid;
  gap: 9px;
  padding: 15px 2px;
  border-bottom: 1px solid #edf0f6;
  min-width: 0;
}

.topic-chart-row:last-child {
  border-bottom: 0;
}

.topic-chart-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.topic-chart-heading span {
  color: #343950;
  font-size: 13px;
  font-weight: 650;
  overflow-wrap: anywhere;
}

.topic-chart-heading strong {
  flex-shrink: 0;
  color: var(--ss-text);
  font-size: 13px;
  font-weight: 800;
}

.topic-chart-track {
  width: 100%;
  height: 9px;
  background: #efefff;
  border-radius: 999px;
  overflow: hidden;
}

.topic-chart-bar {
  height: 100%;
  background: linear-gradient(90deg, #9285ff, #5f4be8);
  border-radius: inherit;
  transition: width .3s ease;
}

.topic-chart-row small {
  color: #8991a6;
  font-size: 11px;
}

/* Forms and buttons */

.study-stats select,
.study-stats button,
.dashboard select,
.dashboard button {
  border-radius: 10px;
}

.dashboard button,
.study-stats button {
  transition: transform .15s ease, box-shadow .15s ease;
}

.dashboard button:hover,
.study-stats button:hover {
  box-shadow: 0 4px 12px rgba(63, 53, 160, 0.1);
}

.dashboard input:focus,
.dashboard select:focus,
.dashboard textarea:focus {
  outline: none;
  border-color: var(--ss-primary);
  box-shadow: 0 0 0 3px rgba(101, 84, 237, .1);
}

@media (min-width: 1000px) {
  .study-stats {
    padding: 30px !important;
  }
}

@media (max-width: 760px) {
  .dashboard {
    width: calc(100% - 24px);
  }

  .study-stats {
    padding: 16px !important;
    border-radius: 16px;
  }

  .study-stats h2 {
    font-size: 21px;
  }

  .topic-analytics {
    padding: 16px !important;
  }

  .analytics-filters {
    grid-template-columns: 1fr;
    padding: 11px;
  }

  .topic-chart-heading {
    align-items: flex-start;
  }
}

/* ===== StudySprint layout correction ===== */

/* Main application width and consistent spacing */
.dashboard {
  width: min(1440px, calc(100% - 48px));
  max-width: none;
  margin: 28px auto;
  padding: 32px;
  box-sizing: border-box;
  background: #fff;
  border: 1px solid #e8eaf4;
  border-radius: 24px;
  box-shadow: 0 12px 40px rgba(35, 40, 85, .055);
}

.dashboard > h1 {
  font-size: clamp(29px, 3vw, 38px);
  line-height: 1.2;
  letter-spacing: -1.1px;
  margin-bottom: 22px;
  color: #191d32;
}

/* XP and streak cards */
.dashboard > p:has(#points),
.dashboard > p:has(#streak),
.dashboard > p:has(#longestStreak) {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  min-height: 60px;
  padding: 13px 18px;
  margin: 0 10px 20px 0;
  border: 1px solid #e8e9f8;
  border-radius: 15px;
  background: #f8f8ff;
  color: #67708a;
  font-size: 14px;
  box-shadow: none;
}

.dashboard > p:has(#points) strong,
.dashboard > p:has(#streak) strong,
.dashboard > p:has(#longestStreak) strong {
  color: #5d4be8;
  font-size: 23px;
  font-weight: 800;
}

/* Statistics shell */
.study-stats {
  margin: 18px 0 24px !important;
  padding: 26px !important;
  border: 1px solid #e7eaf4 !important;
  border-radius: 20px !important;
  background: #fff !important;
  box-shadow: 0 5px 22px rgba(35, 40, 85, .035) !important;
}

.study-stats > h2 {
  margin-bottom: 9px !important;
  font-size: 23px !important;
}

.stats-message {
  color: #778098;
  font-size: 13px;
  line-height: 1.6;
  margin-bottom: 22px;
}

/* These are the actual class names from your HTML. */
.stats-summary {
  display: grid !important;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin: 20px 0 18px;
}

.stats-summary .stat-card {
  min-width: 0;
  min-height: 130px;
  padding: 21px 23px !important;
  margin: 0 !important;
  border: 1px solid #e5e8ff !important;
  border-radius: 16px !important;
  background: linear-gradient(140deg, #fafaff, #f3f3ff) !important;
  box-shadow: none !important;
}

.stats-summary .stat-card h3 {
  margin-bottom: 13px !important;
  font-size: 14px !important;
  color: #69728b;
  font-weight: 650;
}

.stats-summary .stat-card p {
  margin: 7px 0 !important;
  color: #737c94;
  font-size: 13px;
}

.stats-summary .stat-card p strong {
  color: #201b3c;
  font-size: 27px;
  font-weight: 800;
  letter-spacing: -.7px;
}

/* Side-by-side subject and daily chart cards */
.stats-details {
  display: grid !important;
  grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
  align-items: stretch;
  gap: 18px;
}

.stats-details > div {
  min-width: 0;
  min-height: 255px;
  padding: 20px !important;
  border: 1px solid #e8eaf4 !important;
  border-radius: 16px !important;
  background: #fff !important;
  box-shadow: 0 3px 13px rgba(35, 40, 85, .025) !important;
}

.stats-details h3 {
  margin-bottom: 16px !important;
  font-size: 15px !important;
  font-weight: 750;
  color: #252a40;
}

/* Subject list */
.subject-totals {
  padding: 0;
  margin: 0;
  list-style: none;
}

.subject-totals li {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 13px 0;
  border-bottom: 1px solid #edf0f7;
  color: #4b536a;
  font-size: 13px;
}

.subject-totals li:last-child {
  border-bottom: 0;
}

.subject-totals li strong {
  color: #5d4be8;
  white-space: nowrap;
}

/* Topic analytics now follows the main charts */
.topic-analytics {
  margin: 22px 0 0 !important;
  padding: 23px !important;
  border: 1px solid #e7eaf4 !important;
  border-radius: 18px !important;
  background: #fff !important;
  box-shadow: 0 5px 22px rgba(35, 40, 85, .035) !important;
}

.topic-analytics > h3 {
  font-size: 20px !important;
  letter-spacing: -.45px;
}

.topic-analytics > p {
  line-height: 1.6;
}

#topicAnalyticsMessage {
  padding: 11px 13px;
  border-radius: 10px;
  background: #f7f8ff;
  color: #737d96;
  font-size: 12px;
}

.topic-chart-row {
  padding: 16px 2px !important;
}

/* Study session: compact three-column subject selection */
.study-session,
.session-history {
  margin-top: 24px !important;
  padding: 25px !important;
  border: 1px solid #e7eaf4 !important;
  border-radius: 19px !important;
  background: #fff !important;
  box-shadow: 0 5px 22px rgba(35, 40, 85, .035) !important;
}

.session-fields {
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: end;
  gap: 9px 14px;
}

.session-fields label {
  margin: 0 !important;
  color: #626b83;
  font-size: 12px !important;
  font-weight: 700;
}

.session-fields label[for="trackSelect"] {
  grid-column: 1;
  grid-row: 1;
}

.session-fields label[for="subjectSelect"] {
  grid-column: 2;
  grid-row: 1;
}

.session-fields label[for="topicSelect"] {
  grid-column: 3;
  grid-row: 1;
}

.session-fields #trackSelect {
  grid-column: 1;
  grid-row: 2;
}

.session-fields #subjectSelect {
  grid-column: 2;
  grid-row: 2;
}

.session-fields #topicSelect {
  grid-column: 3;
  grid-row: 2;
}

.session-fields select {
  width: 100%;
  min-width: 0;
  min-height: 45px;
  padding: 10px 12px !important;
  border-radius: 10px !important;
  border: 1px solid #e0e4ef !important;
  background-color: #fff;
  color: #2c3248;
  font-size: 13px !important;
}

.timer-display {
  margin: 28px 0 22px !important;
  text-align: center;
  color: #211d3a;
  font-size: clamp(38px, 5vw, 54px) !important;
  font-weight: 800;
  letter-spacing: 2px;
  font-variant-numeric: tabular-nums;
}

.session-actions {
  display: flex;
  gap: 10px;
}

.session-actions button {
  min-width: 110px;
  min-height: 43px;
  padding: 11px 21px !important;
  border: 0 !important;
  border-radius: 10px !important;
  background: #6554ed;
  color: #fff;
  font-weight: 700;
}

.session-actions button:disabled {
  opacity: .48;
  cursor: not-allowed;
}

.session-status {
  margin-top: 14px;
  font-size: 13px;
  color: #737c94;
}

/* Session history table */
.session-history h2 {
  margin-bottom: 12px !important;
}

.history-table-wrap {
  overflow-x: auto;
}

.history-table-wrap table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

.history-table-wrap th,
.history-table-wrap td {
  padding: 13px 12px;
  text-align: left;
  border-bottom: 1px solid #edf0f7;
  white-space: nowrap;
}

.history-table-wrap th {
  color: #6d7690;
  font-weight: 700;
  background: #fafaff;
}

@media (max-width: 760px) {
  .dashboard {
    width: calc(100% - 20px);
    margin: 10px auto;
    padding: 16px;
    border-radius: 17px;
  }

  .study-stats,
  .study-session,
  .session-history {
    padding: 16px !important;
  }

  .stats-summary {
    grid-template-columns: 1fr;
  }

  .stats-details {
    grid-template-columns: minmax(0, 1fr);
  }

  .stats-details > div {
    min-height: 0;
  }

  .session-fields {
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
  }

  .session-fields label[for="trackSelect"],
  .session-fields label[for="subjectSelect"],
  .session-fields label[for="topicSelect"],
  .session-fields #trackSelect,
  .session-fields #subjectSelect,
  .session-fields #topicSelect {
    grid-column: 1;
    grid-row: auto;
  }

  .session-fields label:not(:first-child) {
    margin-top: 8px !important;
  }

  .topic-analytics {
    padding: 16px !important;
  }
}

